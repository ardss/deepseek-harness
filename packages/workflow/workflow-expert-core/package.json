{
  "name": "@deepseek-ai/dsh-workflow-expert-core",
  "description": "Expert workflow engine core: phase state machine, graph scheduler, artifact seeding, snapshot persistence ports, and resume lifecycle. Zero host I/O.",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workflow/workflow-expert-core"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scheduler": {
      "types": "./lib/types/scheduler.d.ts",
      "default": "./lib/types/scheduler.js"
    },
    "./lifecycle": {
      "types": "./lib/types/lifecycle.d.ts",
      "default": "./lib/types/lifecycle.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-workflow-runs": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
